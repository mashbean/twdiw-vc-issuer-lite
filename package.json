{
  "name": "twdiw-vc-issuer-lite",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OID4VCI test-card issuer for Taiwan TWDIW-dialect SD-JWT credentials on Cloudflare Workers, with an embedded OIDC4VP presentation demo and trust-list viewer.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashbean/twdiw-vc-issuer-lite.git"
  },
  "homepage": "https://issuer.mashbean.net",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:mashbean": "wrangler deploy --config wrangler.mashbean.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode-generator": "^0.0.16",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
